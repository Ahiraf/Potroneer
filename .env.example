# Copy to .env for local development, and set the same two variables in
# Vercel ▸ Project ▸ Settings ▸ Environment Variables for production.
#
# Both of these are meant to be public: the anon/publishable key is what the
# browser uses, and every table it can touch is protected by Row Level Security
# in supabase/schema.sql. Never put a service_role key here — anything in a
# VITE_* variable is compiled into the JavaScript bundle and readable by anyone
# who opens the page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
