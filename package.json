{
  "name": "potroneer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cozy bilingual 3D terrarium builder built with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit:themes": "node scripts/audit-themes.mjs",
    "check:layers": "node tools/check-layer-order.mjs",
    "check:sizes": "node tools/check-item-sizes.mjs",
    "check:fit": "node tools/check-item-fit.mjs",
    "check:substrate": "node tools/check-substrate-fit.mjs",
    "check:materials": "node tools/check-natural-materials.mjs",
    "check:grain": "node tools/check-layer-grain.mjs",
    "check:items": "node tools/check-item-appearance.mjs && node tools/check-item-panel.mjs",
    "check:landscaping": "node tools/check-landscaping.mjs",
    "check": "npm run check:layers && npm run check:sizes && npm run check:substrate && npm run check:fit && npm run check:materials && npm run check:grain && npm run check:items && npm run check:landscaping && npm run check:references",
    "check:references": "node tools/check-reference-additions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
